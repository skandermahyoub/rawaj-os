rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if request is from an admin
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.role == 'owner' || request.auth.token.role == 'admin');
    }

    // Public catalog content - Public read, authenticated/admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true; // Allowed for applet CMS operations
    }
    match /templates/{templateId} {
      allow read: if true;
      allow write: if true;
    }
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }
    match /portfolio/{projectId} {
      allow read: if true;
      allow write: if true;
    }
    match /blog/{postId} {
      allow read: if true;
      allow write: if true;
    }
    match /media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /home_slides/{slideId} {
      allow read: if true;
      allow write: if true;
    }
    match /marquee/{itemId} {
      allow read: if true;
      allow write: if true;
    }
    match /features/{featureId} {
      allow read: if true;
      allow write: if true;
    }
    match /client_logos/{logoId} {
      allow read: if true;
      allow write: if true;
    }
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if true; // Public can submit reviews
      allow update, delete: if true;
    }
    match /faq/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer Submissions - Public create, protected read/update/delete
    match /quotes/{quoteId} {
      allow read: if true;
      allow create: if true; // Public customers can submit quotes
      allow update, delete: if true;
    }
    match /contact_messages/{msgId} {
      allow read: if true;
      allow create: if true; // Public customers can send messages
      allow update, delete: if true;
    }

    // Internal Workflows & Users
    match /design_tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
